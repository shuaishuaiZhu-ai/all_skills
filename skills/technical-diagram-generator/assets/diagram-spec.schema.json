{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Technical Diagram Component Specification",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "learningQuestion", "evidence", "layout", "components", "connectors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "learningQuestion": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "required": ["status", "sources"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "unverified"] },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "layout": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["flow-row", "timeline-row", "panel-grid"] } }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["canvas", "section", "panel", "card", "badge", "text-stack", "divider", "status", "note", "table", "connector", "legend"] },
          "groupId": { "type": "string", "minLength": 1 },
          "parentId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "style": { "type": "string" }
        }
      }
    }
  }
}
