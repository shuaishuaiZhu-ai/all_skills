    "status": "confirmed",
    "sources": [
      "C:/home/for_ai/wiki/grace/overview/add1-kernel-for-firmware-engineers.md#3-编译和注册表host-的-add1-怎样找到-gpu-代码"
    ]
  },
  "layout": { "type": "flow-row" },
  "components": [
    {
      "id": "compile",
      "type": "card",
      "groupId": "compile-registry",
      "title": "编译分流",
      "body": [
        "host：main() 与 launch",
        "device：add1 KungFu32 ISA",
        "代码载体：fatbin / .co"
      ],
      "status": "同一份 .cu，形成两侧产物"
    },
    {
      "id": "register",
      "type": "card",
      "groupId": "compile-registry",
      "title": "启动注册",
      "body": [
        "__aicaRegisterFatBinary()",
        "__aicaRegisterFunction()",
        "&add1 → device add1"
      ],
      "status": "已注册，尚未装载"
    },
    {
      "id": "launch",
      "type": "card",
      "groupId": "compile-registry",
      "title": "首次 launch",
      "body": [
        "aicaLaunchKernel(&add1)",
        "装载代码并解析 Init_PC",
        "写入 Job 0x10"
      ],
      "status": "GPU 代码可执行"
    }
  ],
  "connectors": [
    {
      "id": "compile-register",
      "source": "compile",
      "target": "register",
      "label": "模块启动时登记",
      "style": "dashed"
    },
    {
      "id": "register-launch",
      "source": "register",
      "target": "launch",
      "label": "按 &add1 查询",
      "style": "solid"
    }
